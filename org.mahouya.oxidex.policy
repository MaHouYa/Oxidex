<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>Oxidex</vendor>
  <vendor_url>https://github.com/MaHouYa/Oxidex</vendor_url>

  <action id="org.mahouya.oxidex.run-scanner">
    <description>Run the Oxidex Disk Scanner</description>
    <message>Authentication is required to perform a low-level scan of the selected partition.</message>
    <icon_name>oxidex</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/oxidex-scanner-helper</annotate>
  </action>

  <action id="org.mahouya.oxidex.connect-scanner">
    <description>Use the Oxidex scanner service</description>
    <message>Authentication is required to allow Oxidex to scan raw block-device metadata.</message>
    <icon_name>oxidex</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

</policyconfig>
